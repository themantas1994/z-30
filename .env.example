# z-30 does not require any API keys or cloud services - the DSP, LDPC codec, CAT control and
# logbook all run locally. This file exists only to document the handful of optional
# environment variables the app and its build honour.

# APP_URL: Public URL when the web UI is hosted somewhere other than the local
# 127.0.0.1 server started by `z30-web`. Used for self-referential links only.
APP_URL=""

# DISABLE_HMR: Set to "true" to turn off Vite hot-module reloading and file watching
# during development. See vite.config.ts.
DISABLE_HMR=""
