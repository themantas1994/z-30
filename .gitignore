node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# A personal configuration (the retired app wrote config.json) never belongs in the repository.
config.json

# Rust build output
/target/

# Benchmark smoke output (published results live in research/results/<commit>/)
/smoke/

# Agent worktrees (Claude Code isolation); never part of the repository.
/.claude/worktrees/

# Audit evidence logs are evidence, not build noise: `*.log` above silently dropped the 19 logs
# the 2026-09-24 corrective audit cites (RES-13 / F-39). Policy: audit/EVIDENCE_POLICY.md.
!audit/**/evidence/**/*.log

# Suite results that are not the published run (exploratory size, dirty build) are written
# here by default and must never be committed as if they were the record (F-13, F-14).
/research/results/exploratory/
/research/results/unpublished/
