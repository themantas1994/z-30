{
  "name": "z30-transceiver",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run generate && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:ts": "tsx tests/crc14.test.mjs && tsx tests/frontend.test.mjs && tsx tests/transmitPath.test.mjs && tsx tests/rigReadback.test.mjs && tsx tests/rigProbeAndWatchdog.test.mjs && tsx tests/dspDeterminism.test.mjs && tsx tests/audioChannelSafety.test.mjs",
    "test": "npm run lint && npm run test:ts",
    "generate:python-source": "node scripts/generate_python_source.mjs",
    "generate:wiki": "node scripts/generate_wiki_articles.mjs",
    "generate": "npm run generate:python-source && npm run generate:wiki",
    "check:generated": "node scripts/generate_python_source.mjs --check && node scripts/generate_wiki_articles.mjs --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
